# GEMINI_API_KEY: Required for Gemini AI API calls.
# Set this key in your local shell configuration or environment secrets manager of your hosting platform.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this application is hosted.
# Configure this with your local development or production server URL.
# Used for self-referential links, OAuth callbacks, and general API endpoints.
APP_URL="MY_APP_URL"
