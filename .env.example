# Bio Galaxy runs entirely against public, key-free scientific APIs, so no
# secrets are required to develop or deploy it.

# PORT: port the production server listens on. Defaults to 3000.
PORT="3000"

# SITE_URL: canonical public origin used in production SEO metadata and sitemap.
# Set this to the deployed HTTPS origin, with no path or trailing slash.
# SITE_URL="https://example.org"

# GEMINI_API_KEY: enables the daily journal autopublisher. When set, the server
# generates one original, quality-checked article per day at a randomized time
# via the Google Gemini API. When unset, the journal simply serves stored posts.
# GEMINI_API_KEY=""

# GEMINI_MODEL: optional override for the model used by the journal.
# Defaults to "gemini-2.5-flash".
# GEMINI_MODEL="gemini-2.5-flash"
